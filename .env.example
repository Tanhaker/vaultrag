# Postgres owner (runs migrations only; never used by request handlers)
DB_NAME=vaultrag
DB_OWNER_USER=vault
DB_OWNER_PASSWORD=change-me-owner

# App roles: rag_reader serves every user query (RLS enforced), rag_writer runs ingestion
DB_READER_PASSWORD=change-me-reader
DB_WRITER_PASSWORD=change-me-writer

# JWT signing key, and the HMAC key that signs the per-transaction DB security context
JWT_SECRET=change-me-jwt
CTX_HMAC_SECRET=change-me-ctx

DEMO_MODE=true

# LLM / embeddings (Day 2)
LLM_MODEL=gemini/gemini-2.5-flash
EMBEDDING_MODEL=gemini/gemini-embedding-001
GEMINI_API_KEY=
OPENAI_API_KEY=

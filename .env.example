# Postgres owner (runs migrations only; never used by request handlers)
DB_NAME=vaultrag
DB_OWNER_USER=vault
DB_OWNER_PASSWORD=change-me-owner

# App roles: rag_reader serves every user query (RLS enforced), rag_writer runs ingestion
DB_READER_PASSWORD=change-me-reader
DB_WRITER_PASSWORD=change-me-writer

# JWT signing key, and the HMAC key that signs the per-transaction DB security context
JWT_SECRET=change-me-jwt
CTX_HMAC_SECRET=change-me-ctx

DEMO_MODE=true

# Managed Postgres (Neon): set DATABASE_URL to the owner connection string instead of the DB_* values
# DATABASE_URL=postgresql://owner:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# LLM / embeddings. Leave GEMINI_API_KEY empty to run fully offline (hash embeddings, Tesseract,
# extractive answers). With a key: Gemini embeddings, vision OCR, cited generation and verification.
LLM_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
GEMINI_API_KEY=
